# Mirrors the [[headers]] blocks in netlify.toml.
#
# netlify.toml is only read for Git-connected / CLI builds. A drag-and-drop
# deploy to app.netlify.com/drop publishes this folder as-is and never sees it —
# so without this file the same site would go live with none of its headers and
# no asset caching. Keep the two in sync.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Vite content-hashes these filenames, so they can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=604800

/licenses/*
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=604800
